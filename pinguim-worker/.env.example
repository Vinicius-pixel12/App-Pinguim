# ── Supabase (obrigatório) ───────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Worker ───────────────────────────────────────────────────────────────
WORKER_NAME=pinguim-worker-1
WORKER_BATCH_SIZE=3
WORKER_POLL_INTERVAL_MS=3000
WORKER_IDLE_INTERVAL_MS=8000
# Lista separada por vírgula. Vazio = processa todos os tipos.
WORKER_JOB_TYPES=
LOG_LEVEL=info

# ── Cloudflare R2 (futuro) ───────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_MEDIA=
R2_BUCKET_KYC=
R2_PUBLIC_BASE_URL=

# ── FFmpeg (futuro) ──────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── Firebase (futuro) ────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Pagar.me (futuro) ────────────────────────────────────────────────────
PAGARME_SECRET_KEY=
